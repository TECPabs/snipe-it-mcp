# Snipe-IT MCP server - example configuration.
# Placeholders only: never put real values in this file, and never commit a real .env.
# The server does not read .env files itself; copy these names into the "env" block of
# your MCP client configuration (or export them in the shell that launches the server).

# --- Required ---
# Must be https://. Plain http:// is rejected unless the host is localhost / 127.0.0.1 / [::1].
SNIPEIT_URL=https://snipe.example.com
SNIPEIT_API_TOKEN=replace-with-a-least-privilege-api-token

# --- Security (optional; every default is the most restrictive choice) ---
# Write tools to enable: comma-separated tool names, or * for all.
# Empty = read-only server (no create / update / checkout / checkin / audit).
SNIPEIT_WRITE_TOOLS=

# Snipe-IT company IDs this server may see and change (comma-separated, e.g. 1,4).
# Empty = no company restriction (a warning is logged at startup).
SNIPEIT_ALLOWED_COMPANY_IDS=

# Extra response fields to unlock, as resource.field (e.g. hardware.custom_fields,hardware.notes).
# Only documented unlockable fields are accepted; licenses.product_key can never be unlocked.
SNIPEIT_EXTRA_FIELDS=

# Accept plain http:// for a non-loopback host. Leave unset outside an isolated lab.
# SNIPEIT_ALLOW_INSECURE_HTTP=true

# --- Other (optional) ---
# LOG_LEVEL=info
# SNIPEIT_TIMEOUT_MS=30000
