{
  "name": "@tecpabs/snipe-it-mcp",
  "version": "1.2.0",
  "description": "MCP server for Snipe-IT asset management — query and manage assets, users, licenses, and more via Claude",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "snipe-it-mcp": "dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src tests",
    "prepublishOnly": "npm run build && npm test && npm run lint"
  },
  "keywords": [
    "mcp",
    "snipe-it",
    "asset-management",
    "claude",
    "model-context-protocol",
    "itam"
  ],
  "author": "TEC Building Systems LLC",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TECPabs/snipe-it-mcp.git"
  },
  "homepage": "https://github.com/TECPabs/snipe-it-mcp#readme",
  "bugs": {
    "url": "https://github.com/TECPabs/snipe-it-mcp/issues"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "files": [
    "dist"
  ],
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.25.3"
  },
  "devDependencies": {
    "@types/node": "^22.20.3",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^9.0.0",
    "typescript": "^5.4.0",
    "vitest": "^5.0.1"
  }
}
